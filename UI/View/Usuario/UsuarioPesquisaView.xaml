<Window x:Class="UI.View.Usuario.UsuarioPesquisaView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UI.View.Usuario"
        mc:Ignorable="d"
        Title="UsuarioPesquisaView" Height="450" Width="800"
        Background="#F5F5F5">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 🔍 FILTRO -->
        <Border Background="White" Padding="10" CornerRadius="5" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBox Width="250"
                         Height="30"
                         Margin="0,0,10,0"
                         FontSize="14"
                         VerticalContentAlignment="Center"
                         Text="{Binding FiltroTitulo}" />

                    <CheckBox Content="{Binding TextoCheckBox}"
                          IsChecked="{Binding ProcurarInativo}"
                          VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                        Grid.Column="1"
                        HorizontalAlignment="Right">

                    <Button Content="Pesquisar"
                        Command="{Binding PesquisarCommand}"
                        Style="{StaticResource PrimaryButton}"
                        Margin="5,0"/>

                    <Button Content="Incluir"
                        Command="{Binding IncluirCommand}"
                        Style="{StaticResource SuccessButton}"
                        Margin="5,0"/>

                    <Button Content="Alterar"
                        Command="{Binding AlterarCommand}"
                        Style="{StaticResource PrimaryButton}"
                        Margin="5,0"/>

                    <Button Content="Excluir"
                        Command="{Binding ExcluirCommand}"
                        Style="{StaticResource DangerButton}"
                        Margin="5,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 📋 LISTA -->
        <Border Grid.Row="1" Background="White" CornerRadius="5" Padding="5">
            <ListView Style="{StaticResource DefaultListViewStyle}" 
                  ItemsSource="{Binding ListaTarefas}"
                  SelectedItem="{Binding TarefaSelecionada}"
                  MouseDoubleClick="ListView_MouseDoubleClick">

                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Título" Width="200"
                        DisplayMemberBinding="{Binding Titulo}" />

                        <GridViewColumn Header="Desenvolvedor" Width="120"
                        DisplayMemberBinding="{Binding NomeDesenvolvedor}" />

                        <GridViewColumn Header="Status" Width="120"
                        DisplayMemberBinding="{Binding Status}" />

                        <GridViewColumn Header="Início" Width="100">
                            <GridViewColumn.DisplayMemberBinding>
                                <Binding Path="DataInicio" StringFormat="{}{0:dd/MM/yyyy}" />
                            </GridViewColumn.DisplayMemberBinding>
                        </GridViewColumn>

                        <GridViewColumn Header="Fim Prev." Width="100">
                            <GridViewColumn.DisplayMemberBinding>
                                <Binding Path="DataFimPrevisto" StringFormat="{}{0:dd/MM/yyyy}" />
                            </GridViewColumn.DisplayMemberBinding>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <!-- ⚙️ RODAPÉ -->
        <StackPanel Grid.Row="2"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Margin="0,10,0,0">

            <Button Content="Sair"
                Width="100"
                Height="35"
                Click="cmdSair_Click"
                Style="{StaticResource DangerButton}"/>
        </StackPanel>
    </Grid>
</Window>
