<Window x:Class="UI.View.Usuario.UsuarioPesquisaView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pesquisa de Usuários"
        Height="500"
        Width="900"
        MinHeight="450"
        MinWidth="750"
        WindowStartupLocation="CenterOwner"
        Background="#F5F5F5">

    <Grid Margin="15">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- FILTROS E AÇÕES -->
        <Border Grid.Row="0"
                Margin="0,0,0,10"
                Padding="10"
                Background="White"
                CornerRadius="5">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- FILTROS -->
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <TextBox Width="250"
                             Height="30"
                             Margin="0,0,10,0"
                             Padding="5,0"
                             FontSize="14"
                             VerticalContentAlignment="Center"
                             ToolTip="Informe o nome ou login"
                             Text="{Binding Filtro,
                                            UpdateSourceTrigger=PropertyChanged}"/>

                    <CheckBox Content="Mostrar inativos"
                              VerticalAlignment="Center"
                              IsChecked="{Binding ProcurarInativo}"/>

                </StackPanel>

                <!-- AÇÕES -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">

                    <Button Content="Pesquisar"
                            Command="{Binding PesquisarCommand}"
                            Style="{StaticResource PrimaryButton}"
                            Margin="5,0"/>

                    <Button Content="Incluir"
                            Command="{Binding IncluirCommand}"
                            CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                            Style="{StaticResource SuccessButton}"
                            Margin="5,0"/>

                    <Button Content="Alterar"
                            Command="{Binding AlterarCommand}"
                            Style="{StaticResource PrimaryButton}"
                            Margin="5,0"/>

                    <Button Content="Inativar"
                            Command="{Binding InativarCommand}"
                            Style="{StaticResource DangerButton}"
                            Margin="5,0"/>

                </StackPanel>
            </Grid>
        </Border>

        <!-- LISTA DE USUÁRIOS -->
        <Border Grid.Row="1"
                Padding="5"
                Background="White"
                CornerRadius="5">

            <ListView ItemsSource="{Binding ListaUsuarios}"
                      SelectedItem="{Binding UsuarioSelecionado}"
                      Style="{StaticResource DefaultListViewStyle}">

                <ListView.View>
                    <GridView>

                        <GridViewColumn Header="Nome"
                                        Width="250"
                                        DisplayMemberBinding="{Binding Nome}"/>

                        <GridViewColumn Header="Login"
                                        Width="160"
                                        DisplayMemberBinding="{Binding Login}"/>

                        <GridViewColumn Header="Cadastro"
                                        Width="120">

                            <GridViewColumn.DisplayMemberBinding>
                                <Binding Path="DataCadastro"
                                         StringFormat="{}{0:dd/MM/yyyy}"/>
                            </GridViewColumn.DisplayMemberBinding>

                        </GridViewColumn>

                        <GridViewColumn Header="Atualização"
                                        Width="120">

                            <GridViewColumn.DisplayMemberBinding>
                                <Binding Path="DataAtualizacao"
                                         StringFormat="{}{0:dd/MM/yyyy}"/>
                            </GridViewColumn.DisplayMemberBinding>

                        </GridViewColumn>

                        <GridViewColumn Header="Situação"
                                        Width="100">

                            <GridViewColumn.CellTemplate>
                                <DataTemplate>

                                    <TextBlock FontWeight="SemiBold"
                                               Text="Ativo"
                                               Foreground="#2E7D32">

                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">

                                                <Setter Property="Text"
                                                        Value="Ativo"/>

                                                <Setter Property="Foreground"
                                                        Value="#2E7D32"/>

                                                <Style.Triggers>

                                                    <DataTrigger Binding="{Binding Inativo}"
                                                                 Value="True">

                                                        <Setter Property="Text"
                                                                Value="Inativo"/>

                                                        <Setter Property="Foreground"
                                                                Value="#C62828"/>

                                                    </DataTrigger>

                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>

                                    </TextBlock>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>

                        </GridViewColumn>

                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <!-- RODAPÉ -->
        <Border Grid.Row="2"
                Margin="0,10,0,0"
                Padding="10"
                Background="White"
                CornerRadius="5">

            <Grid>

                <TextBlock VerticalAlignment="Center" Foreground="#718096">

                    <Run Text="Usuários encontrados: "/>
                    <Run Text="{Binding ListaUsuarios.Count, Mode=OneWay}" FontWeight="SemiBold"/>

                </TextBlock>

                <Button Content="Sair"
                        Width="100"
                        Height="35"
                        HorizontalAlignment="Right"
                        Command="{Binding SairCommand}"
                        Style="{StaticResource DangerButton}"/>

            </Grid>
        </Border>

    </Grid>
</Window>