<Window x:Class="UI.View.Tarefa.TarefaPesquisaView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UI.View.Tarefa"
        mc:Ignorable="d"
        Title="TarefaPesquisaView" Height="450" Width="800">
    <Grid Background="White">
        <DockPanel>
            <StackPanel Margin="0,0,0,10" 
                    DockPanel.Dock="Top" 
                    Orientation="Horizontal" 
                    VerticalAlignment="Center"
                    Visibility="Hidden">
                <StackPanel Margin="0,0,5,0" Orientation="Vertical">
                    <Label Content="codigo 1" />
                </StackPanel>
            </StackPanel>
            <StackPanel Margin="0,0,0,10" DockPanel.Dock="Top" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                <StackPanel Margin="0,0,5,0" Orientation="Horizontal">
                    <Button x:Name="cmdPesquisar" Command="{Binding PesquisarCommand}" Margin="10,0,10,0"  Content="Pesquisar" Padding="5,5,5,5"/>
                    <Button x:Name="cmdIncluir"   Command="{Binding IncluirCommand}" Margin="10,0,10,0"  Content="Incluir" Padding="5,5,5,5"/>
                    <Button x:Name="cmdAlterar"   Command="{Binding AlterarCommand}" Margin="10,0,10,0"  Content="Alterar" Padding="5,5,5,5"/>
                    <Button x:Name="cmdExcluir"   Command="{Binding ExcluirCommand}" Margin="10,0,10,0"  Content="Excluir" Padding="5,5,5,5"/>
                </StackPanel>
            </StackPanel>
            <StackPanel x:Name="stpRodape" DockPanel.Dock="Bottom" Orientation="Horizontal">
                <StackPanel Margin="0,0,5,0" Orientation="Vertical" Visibility="Hidden">
                    <Label Content="Código" />
                </StackPanel>
                <StackPanel Margin="0,0,5,0" Orientation="Vertical"/>
                <StackPanel Margin="0,0,5,0" Orientation="Vertical"/>
            </StackPanel>
            <StackPanel Margin="0,0,0,10" DockPanel.Dock="Bottom" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                <StackPanel Margin="0,0,5,0" Orientation="Horizontal">
                    <Button x:Name="cmdSair" Margin="20,5,20,5"  Content="Sair" Padding="15,10,15,10" Width="86" Click="cmdSair_Click"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Orientation="Vertical">
                <StackPanel Orientation="Horizontal" Margin="0,10,0,10" >
                    <TextBox x:Name="txtNome"  Margin="15,0,5,0" Width="257" FontSize="16"/>
                    <CheckBox Content="{Binding TextoCheckBox}" 
                          IsChecked="{Binding ProcurarInativo}" 
                          Margin="0,5,5,0"/>
                </StackPanel>
                <ListView ItemsSource="{Binding ListaTarefas}" 
                      SelectedItem="{Binding TarefaSelecionada}" 
                      MouseDoubleClick="ListView_MouseDoubleClick">

                    <ListView.View>
                        <GridView>

                            <GridViewColumn Header="Título"
                        DisplayMemberBinding="{Binding Titulo}"
                        Width="200"/>

                            <GridViewColumn Header="Desenvolvedor"
                        DisplayMemberBinding="{Binding Desenvolvedor}"
                        Width="120"/>

                            <GridViewColumn Header="Status"
                        DisplayMemberBinding="{Binding Status.Nome}"
                        Width="120"/>

                            <GridViewColumn Header="Início"
                        Width="100">
                                <GridViewColumn.DisplayMemberBinding>
                                    <Binding Path="DataInicio"
                         StringFormat="{}{0:dd/MM/yyyy}" />
                                </GridViewColumn.DisplayMemberBinding>
                            </GridViewColumn>

                            <GridViewColumn Header="Fim Prev."
                        Width="100">
                                <GridViewColumn.DisplayMemberBinding>
                                    <Binding Path="DataFimPrevisto"
                         StringFormat="{}{0:dd/MM/yyyy}" />
                                </GridViewColumn.DisplayMemberBinding>
                            </GridViewColumn>

                        </GridView>
                    </ListView.View>
                </ListView>

            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
