<Window x:Class="UI.View.TarefaCadastroView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:System="clr-namespace:System;assembly=mscorlib"
    xmlns:local="clr-namespace:UI.View"
    mc:Ignorable="d"
    Title="TarefaCadastroView" Height="450" Width="800" Loaded="FrmTarefaCadastro_Loaded">
    <TabControl Margin="0,10,0,0" SelectedIndex="{Binding AbaSelecionada}">
        <TabItem Header="Cadastro">
            <Grid Background="White">
                <DockPanel>
                    <StackPanel Margin="0,0,0,10" DockPanel.Dock="Top" Orientation="Horizontal"
                        VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Visibility="Hidden">
                            <StackPanel Margin="0,0,5,0" Orientation="Vertical">
                                <Label Content="Código" />
                            </StackPanel>
                            <StackPanel Margin="0,0,5,0" Orientation="Vertical">
                                <Label Content="Usuario" />

                            </StackPanel>
                            <StackPanel Margin="0,0,5,0" Orientation="Vertical">
                                <Label Content="Atualização" />

                            </StackPanel>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            Margin="220,5,0,0">
                            <Button x:Name="btnConfirmar" Content="_Confirmar" Margin="0,0,10,0"
                                Click="btnConfirmar_Click" />
                            <Button x:Name="btnCancelar" Content="Ca_ncelar"
                                Click="btnCancelar_Click" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel x:Name="stpRodape" DockPanel.Dock="Bottom" Orientation="Horizontal">
                        <StackPanel Margin="0,0,5,0" Orientation="Vertical">
                            <Label Content="Código" x:Name="codigoGuid" />
                        </StackPanel>
                        <StackPanel Margin="0,0,5,0" Orientation="Vertical">
                            <Label Content="Usuario" x:Name="usuarioMatricula" Visibility="Hidden" />

                        </StackPanel>
                        <StackPanel Margin="0,0,5,0" Orientation="Vertical">
                            <Label Content="Atualização" x:Name="dataAtualizacao" />

                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <StackPanel Orientation="Vertical" Width="350">
                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                <Label Content="Titulo" Margin="0,5,40,0" />
                                <TextBox x:Name="txtTitulo" Width="250" KeyDown="txtTitulo_KeyDown" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                <Label Content="Descricao" Margin="0,5,19,0" />
                                <TextBox x:Name="txtDescricao" Width="250" Height="180"
                                    AcceptsReturn="True"
                                    TextWrapping="Wrap"
                                    VerticalScrollBarVisibility="Auto"
                                    KeyDown="txtDescricao_KeyDown" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                <Label Content="status" Margin="0,5,40,0" />
                                <ComboBox x:Name="cmbStatus" Width="200" DisplayMemberPath="Nome"
                                    SelectedValuePath="Id" KeyDown="cmbStatus_KeyDown" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                <Label Content="Dev" Margin="0,5,50,0" />
                                <ComboBox x:Name="cmbDev" Width="200" DisplayMemberPath="Nome"
                                    SelectedValuePath="Id" KeyDown="cmbDev_KeyDown" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Orientation="Vertical">
                            <StackPanel Orientation="Horizontal" Width="70"
                                HorizontalAlignment="Left">
                                <CheckBox x:Name="chkInativo" Content="Inativo" Margin="0,5,5,0"
                                    IsChecked="False" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                <Label Content="Data Cadastro" Margin="0,5,20,0" />
                                <DatePicker SelectedDateFormat="Short" x:Name="DateCadastro"
                                    IsEnabled="False" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                <Label Content="Data Inicio" Margin="0,5,39,0" />
                                <DatePicker SelectedDateFormat="Short"
                                    SelectedDate="{x:Static System:DateTime.Now}"
                                    x:Name="DateInicio"
                                    KeyDown="DateInicio_KeyDown"
                                    Loaded="DateInicio_Loaded"
                                />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                <Label Content="Data Prevista" Margin="0,5,27,0" />
                                <DatePicker SelectedDateFormat="Short"
                                    x:Name="DatePrevisto"
                                    KeyDown="DatePrevisto_KeyDown"
                                    Loaded="DatePrevisto_Loaded" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                <Label Content="Data Fim" Margin="0,5,50,0" />
                                <DatePicker SelectedDateFormat="Short"
                                    x:Name="DateFim"
                                    KeyDown="DateFim_KeyDown"
                                    Loaded="DateFim_Loaded" />
                            </StackPanel>

                        </StackPanel>

                    </StackPanel>
                </DockPanel>
            </Grid>
        </TabItem>
        <TabItem Header="Etapas" x:Name="tbEtapas" Loaded="tbEtapas_Loaded">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                        Margin="0,0,0,10">
                        <Button Content="Adicionar" Width="100" Margin="0,0,10,0"
                            Command="{Binding AdicionarEtapaCommand}" />
                        <Button Content="Alterar" Width="100" Margin="0,0,10,0"
                            Command="{Binding AlterarEtapaCommand}" />
                        <Button Content="Remover" Width="100" Margin="0,0,10,0"
                            Command="{Binding RemoverEtapaCommand}" />
                    </StackPanel>
                    <StackPanel>
                        <StackPanel Margin="0,0,10,0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Left">
                            <Button Content="Consultar" Width="100" Margin="0,0,10,0"
                                Command="{Binding ConsultarEtapaCommand}" />
                            <Label Content="Descrição:" />
                            <TextBox Margin="10,0,10,0" Width="250"
                                Text="{Binding FiltroDescricaoEtapa, UpdateSourceTrigger=PropertyChanged}"
                                x:Name="txtDescricaoEtapa" />

                        </StackPanel>
                        <StackPanel Margin="0,0,10,0" Orientation="Vertical"
                            VerticalAlignment="Center" HorizontalAlignment="Right">
                            <StackPanel Orientation="Horizontal">
                                <CheckBox Content="Inativo"
                                    IsChecked="{Binding MostrarInativoEtapa}"
                                    x:Name="chkInativoEtapa" Margin="0,5,5,0"
                                    Click="chkInativoEtapa_Click" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
                <DataGrid Grid.Row="1" IsReadOnly="False" Width="600" x:Name="dgEtapa"
                    ItemsSource="{Binding ListaEtapas}" SelectedItem="{Binding EtapaSelecionada}"
                    AutoGenerateColumns="False" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="150"
                            IsReadOnly="True" />
                        <DataGridTextColumn Header="Titulo" Binding="{Binding Descricao}"
                            Width="200" IsReadOnly="True" />
                        <DataGridTextColumn Header="Data Prevista"
                            Binding="{Binding DataFimPrevisto}" Width="120" IsReadOnly="True" />
                        <DataGridTextColumn Header="Tempo Restante"
                            Binding="{Binding TempoRestante}" Width="120" IsReadOnly="True" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </TabItem>
    </TabControl>
</Window>