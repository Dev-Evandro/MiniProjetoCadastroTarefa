<Window x:Class="UI.View.TarefaCadastroView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:System="clr-namespace:System;assembly=mscorlib"
    xmlns:local="clr-namespace:UI.View"
    mc:Ignorable="d"
    Title="TarefaCadastroView" Height="600" Width="900" Loaded="TarefaCadastro_Loaded">
    <TabControl Margin="0,10,0,0" SelectedIndex="{Binding AbaSelecionada}">
        <TabItem Header="Cadastro">
            <Grid Background="#F5F5F5" Margin="10">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 🔵 AÇÕES -->
                <Border Background="White" Padding="10" CornerRadius="5" Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Confirmar" x:Name="btnConfirmar"
                        Style="{StaticResource BtnSucesso}"
                        Click="btnConfirmar_Click"/>

                        <Button Content="Cancelar" x:Name="btnCancelar"
                        Style="{StaticResource BtnPerigo}"
                        Click="btnCancelar_Click"/>
                    </StackPanel>
                </Border>

                <!-- 🔵 FORMULÁRIO -->
                <Border Grid.Row="1" Background="White" Padding="15" CornerRadius="5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- ESQUERDA -->
                        <Grid Margin="0,0,10,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Label Content="Título"/>
                            <TextBox Grid.Row="1" x:Name="txtTitulo"
                             Text="{Binding Titulo}"
                             Height="30"/>

                            <Label Grid.Row="2" Content="Descrição" Margin="0,10,0,0"/>
                            <TextBox Grid.Row="3" x:Name="txtDescricao"
                             Height="150"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"/>
                        </Grid>

                        <!-- DIREITA -->
                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Label Content="Status"/>
                            <ComboBox Grid.Row="1" 
                                      Height="30" 
                                      x:Name="cmbStatus" 
                                      DisplayMemberPath="Nome" 
                                      SelectedValuePath="Id"/>

                            <Label Grid.Row="2" Content="Desenvolvedor" Margin="0,10,0,0"/>
                            <ComboBox Grid.Row="3" 
                                      Height="30" 
                                      x:Name="cmbDev"
                                      DisplayMemberPath="Nome" 
                                      SelectedValuePath="Id"/>

                            <CheckBox Grid.Row="4" x:Name="chkInativo"
                              Content="Inativo"
                              Margin="0,10,0,0"/>

                            <StackPanel Grid.Row="5" Margin="0,10,0,0">
                                <Label Content="Data Início"/>
                                <DatePicker x:Name="DateInicio"/>

                                <Label Content="Data Prevista" Margin="0,10,0,0"/>
                                <DatePicker x:Name="DatePrevisto"/>

                                <Label Content="Data Fim" Margin="0,10,0,0"/>
                                <DatePicker x:Name="DateFim"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- 🔵 RODAPÉ -->
                <Border Grid.Row="2" Background="White" Padding="10" CornerRadius="5" Margin="0,10,0,0">
                    <StackPanel Orientation="Horizontal" >
                        <TextBlock Text="Código: ..." x:Name="codigoGuid" Margin="0,0,20,0"/>
                        <TextBlock Text="Atualização: ..." x:Name="dataAtualizacao"/>
                    </StackPanel>
                </Border>

            </Grid>
        </TabItem>
        <TabItem Header="Etapas" x:Name="tbEtapas">
            <Grid Margin="10" Background="#F5F5F5">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- AÇÕES -->
                <Border Background="White" Padding="10" CornerRadius="5" Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Adicionar" Style="{StaticResource BtnSucesso}" Command="{Binding AdicionarEtapaCommand}"/>
                        <Button Content="Alterar" Style="{StaticResource BtnPadrao}" Command="{Binding AlterarEtapaCommand}"/>
                        <Button Content="Remover" Style="{StaticResource BtnPerigo}" Command="{Binding RemoverEtapaCommand}"/>
                    </StackPanel>
                </Border>

                <!-- FILTRO -->
                <Border Grid.Row="1" Background="White" Padding="10" CornerRadius="5" Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                        <Button Content="Consultar"
                        Style="{StaticResource BtnPadrao}"
                        Command="{Binding ConsultarEtapaCommand}"/>

                        <TextBox Width="250"
                         Margin="10,0"
                         Text="{Binding FiltroDescricaoEtapa}"/>

                        <CheckBox Content="Inativo"
                          IsChecked="{Binding MostrarInativoEtapa}"
                          Margin="10,0"/>
                    </StackPanel>
                </Border>

                <!-- GRID -->
                <Border Grid.Row="2" Background="White" CornerRadius="5" Padding="5">
                    <DataGrid ItemsSource="{Binding ListaEtapas}"
                      SelectedItem="{Binding EtapaSelecionada}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False">

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="150"/>
                            <DataGridTextColumn Header="Descrição" Binding="{Binding Descricao}" Width="200"/>
                            <DataGridTextColumn Header="Data Prevista" Binding="{Binding DataFimPrevisto}" Width="120"/>
                            <DataGridTextColumn Header="Tempo Restante" Binding="{Binding TempoRestante}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

            </Grid>
        </TabItem>
    </TabControl>
</Window>