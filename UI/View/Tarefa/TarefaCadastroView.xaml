<Window
    x:Class="UI.View.TarefaCadastroView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:System="clr-namespace:System;assembly=mscorlib"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:UI.View"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit" xmlns:controls="clr-namespace:UI.Framework.Controls"
    Title="TarefaCadastroView"
    Width="900"
    Height="640"
    Loaded="TarefaCadastro_Loaded"
    mc:Ignorable="d">
    <TabControl Margin="0,10,0,0" SelectedIndex="{Binding AbaSelecionada}">
        <TabItem Header="Cadastro">
            <Grid Margin="10" Background="#F5F5F5">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  🔵 AÇÕES  -->
                <Border
                    Margin="0,0,0,10"
                    Padding="10"
                    Background="White"
                    CornerRadius="5">
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button
                            x:Name="btnConfirmar"
                            Click="btnConfirmar_Click"
                            Content="Confirmar"
                            Style="{StaticResource PrimaryButton}" />

                        <Button
                            x:Name="btnCancelar"
                            Click="btnCancelar_Click"
                            Content="Cancelar"
                            Style="{StaticResource DangerButton}" />
                    </StackPanel>
                </Border>

                <!--  🔵 FORMULÁRIO  -->
                <Border
                    Grid.Row="1"
                    Padding="15"
                    Background="White"
                    CornerRadius="5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!--  ESQUERDA  -->
                        <Grid Margin="0,0,10,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Label Content="Título" />
                            <TextBox
                                x:Name="txtTitulo"
                                Grid.Row="1"
                                Height="30"
                                Text="{Binding Titulo}" />

                            <Label
                                Grid.Row="2"
                                Margin="0,10,0,0"
                                Content="Descrição" />
                            <TextBox
                                x:Name="txtDescricao"
                                Grid.Row="3"
                                Height="150"
                                AcceptsReturn="True"
                                TextWrapping="Wrap" />
                        </Grid>

                        <!--  DIREITA  -->
                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Label Content="Status" />
                            <ComboBox
                                x:Name="cmbStatus"
                                Grid.Row="1"
                                Height="30"
                                DisplayMemberPath="Nome"
                                SelectedValuePath="Id" />

                            <Label
                                Grid.Row="2"
                                Margin="0,10,0,0"
                                Content="Desenvolvedor" />
                            <ComboBox
                                x:Name="cmbDev"
                                Grid.Row="3"
                                Height="30"
                                DisplayMemberPath="Nome"
                                SelectedValuePath="Id" />

                            <CheckBox
                                x:Name="chkInativo"
                                Grid.Row="4"
                                Margin="0,10,0,0"
                                Content="Inativo" />

                            <StackPanel Grid.Row="5" Margin="0,10,0,0">
                                <Label Content="Data Início" />
                                <DatePicker x:Name="DateInicio" />

                                <Label Margin="0,10,0,0" Content="Data Prevista" />
                                <DatePicker x:Name="DatePrevisto" />

                                <Label Margin="0,10,0,0" Content="Data Fim" />
                                <DatePicker x:Name="DateFim" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!--  🔵 RODAPÉ  -->
                <Border
                    Grid.Row="2"
                    Margin="0,10,0,0"
                    Padding="10"
                    Background="White"
                    CornerRadius="5">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Margin="0,5,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Margin="0,0,5,0" Text="Código:" />
                                <TextBlock
                                    x:Name="codigoGuid"
                                    Margin="0,0,5,0"
                                    Text="Guid" />
                            </StackPanel>

                        </StackPanel>
                        <StackPanel Grid.Row="1" Margin="0,5,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Margin="0,0,5,0" Text="Data Cadastro: " />
                                <TextBlock x:Name="dataCadastro" Text="Cadastro" />
                            </StackPanel>

                        </StackPanel>
                        <StackPanel Grid.Row="2" Margin="0,5,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Margin="0,0,5,0" Text="Data Atualizacao: " />
                                <TextBlock x:Name="dataAtualizacao" Text="Atualização" />
                            </StackPanel>

                        </StackPanel>
                    </Grid>

                </Border>

            </Grid>
        </TabItem>
        <TabItem
            x:Name="tbEtapas"
            Height="20"
            VerticalAlignment="Top"
            Header="Etapas">
            <Grid Margin="10" Background="#F5F5F5">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  AÇÕES  -->
                <Border
                    Margin="0,0,0,10"
                    Padding="10"
                    Background="White"
                    CornerRadius="5">
                    <StackPanel Orientation="Horizontal">
                        <Button
                            Command="{Binding AdicionarEtapaCommand}"
                            Content="Adicionar"
                            Style="{StaticResource PrimaryButton}" />
                        <Button
                            Command="{Binding AlterarEtapaCommand}"
                            Content="Alterar"
                            Style="{StaticResource PrimaryButton}" />
                        <Button
                            Command="{Binding RemoverEtapaCommand}"
                            Content="Remover"
                            Style="{StaticResource DangerButton}" />
                    </StackPanel>
                </Border>

                <!--  FILTRO  -->
                <Border
                    Grid.Row="1"
                    Margin="0,0,0,10"
                    Padding="10"
                    Background="White"
                    CornerRadius="5">
                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">

                        <Button
                            Command="{Binding ConsultarEtapaCommand}"
                            Content="Consultar"
                            Style="{StaticResource PrimaryButton}" />

                        <TextBox
                            Width="250"
                            Margin="10,0"
                            Text="{Binding FiltroDescricaoEtapa}" />

                        <CheckBox
                            Margin="10,0"
                            Content="Inativo"
                            IsChecked="{Binding MostrarInativoEtapa}" />
                    </StackPanel>
                </Border>

                <!--  GRID  -->
                <Border Grid.Row="2"  Padding="5"  Background="White"  CornerRadius="5">
                    <DataGrid AutoGenerateColumns="False" 
                              CanUserAddRows="False"
                              ItemsSource="{Binding ListaEtapas}" 
                              SelectedItem="{Binding EtapaSelecionada}" 
                              Style="{StaticResource DefaultDataGridStyle}">

                        <DataGrid.Columns>
                            <DataGridTextColumn
                                Width="150"
                                Binding="{Binding Id}"
                                Header="Id" />
                            <DataGridTextColumn
                                Width="200"
                                Binding="{Binding Descricao}"
                                Header="Descrição" />
                            <DataGridTextColumn
                                Width="120"
                                Binding="{Binding DataFimPrevisto, StringFormat={}{0:dd/MM/yyyy}}"
                                Header="Data Prevista" />
                            <DataGridTextColumn
                                Width="120"
                                Binding="{Binding TempoRestante}"
                                Header="Tempo Restante" />
                            <DataGridTemplateColumn Header="Status">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <controls:StatusBadge Status="{Binding Status}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

            </Grid>
        </TabItem>
    </TabControl>
</Window>
