<Window x:Class="UI.View.EtapaCadastroView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cadastro de Etapa"
        Height="450"
        Width="700"
        Background="#F5F5F5">

    <Grid Margin="15">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 🔵 AÇÕES -->
        <Border Background="White" Padding="10" CornerRadius="5" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Salvar"
                        Width="100"
                        Command="{Binding SalvarCommand}"
                        Style="{StaticResource PrimaryButton}"/>

                <Button Content="Cancelar"
                        Width="100"
                        Command="{Binding CancelarCommand}"
                        Style="{StaticResource DangerButton}"/>
            </StackPanel>
        </Border>

        <!-- 🔵 FORMULÁRIO -->
        <Border Grid.Row="1" Background="White" Padding="15" CornerRadius="5">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ESQUERDA -->
                <Grid Margin="0,0,10,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Label Content="Título"/>
                    <TextBox Grid.Row="1"
                             Height="30"
                             Text="{Binding Etapa.Titulo, UpdateSourceTrigger=PropertyChanged}"/>

                    <Label Grid.Row="2" Content="Descrição" Margin="0,10,0,0"/>
                    <TextBox Grid.Row="3"
                             Height="150"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             Text="{Binding Etapa.Descricao}"/>
                </Grid>

                <!-- DIREITA -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <CheckBox Content="Inativo"
                              IsChecked="{Binding Etapa.Inativo}"
                              Margin="0,0,0,10"/>

                    <StackPanel Grid.Row="1">
                        <Label Content="Data Início"/>
                        <DatePicker SelectedDate="{Binding Etapa.DataInicio}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Margin="0,10,0,0">
                        <Label Content="Data Prevista"/>
                        <DatePicker SelectedDate="{Binding Etapa.DataFimPrevisto}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="3" Margin="0,10,0,0">
                        <Label Content="Data Fim"/>
                        <DatePicker SelectedDate="{Binding Etapa.DataFimReal}"/>
                    </StackPanel>

                </Grid>
            </Grid>
        </Border>

        <!-- 🔵 RODAPÉ -->
        <Border Grid.Row="2" Background="White" Padding="10" CornerRadius="5" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Código: " FontWeight="Bold"/>
                <TextBlock Text="{Binding Etapa.Id}" Margin="5,0,20,0"/>
            </StackPanel>
        </Border>

    </Grid>
</Window>