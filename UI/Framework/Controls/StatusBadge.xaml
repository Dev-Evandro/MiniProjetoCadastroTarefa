<UserControl
    x:Class="UI.Framework.Controls.StatusBadge"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Name="root">

    <Border Padding="10,4" CornerRadius="0">

        <Border.Style>

            <Style TargetType="Border">

                <Setter Property="Background" Value="Gray" />

                <Style.Triggers>

                    <DataTrigger Binding="{Binding Status, ElementName=root}" Value="Concluído">

                        <Setter Property="Background" Value="#48BB78" />

                    </DataTrigger>

                    <DataTrigger Binding="{Binding Status, ElementName=root}" Value="Pendente">

                        <Setter Property="Background" Value="#ECC94B" />

                    </DataTrigger>

                    <DataTrigger Binding="{Binding Status, ElementName=root}" Value="Atrasado">

                        <Setter Property="Background" Value="#F56565" />

                    </DataTrigger>

                </Style.Triggers>

            </Style>

        </Border.Style>

        <TextBlock
            HorizontalAlignment="Center"
            FontWeight="SemiBold"
            Foreground="White"
            Text="{Binding Status, ElementName=root}" />

    </Border>

</UserControl>
